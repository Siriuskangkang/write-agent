# Docker Desktop defaults: MySQL, Redis, and Qdrant only.
DATABASE_NAME=textweaver
DATABASE_USER=textweaver
DATABASE_PASSWORD=textweaver_local
MYSQL_ROOT_PASSWORD=textweaver_root_local
REDIS_PASSWORD=redis_local

# Deterministic authoring is fail-safe off until storage broker readiness is
# proven and individual project UUIDs are explicitly allowlisted.
AUTHORING_COMMIT_MODE=off
AUTHORING_ALLOWLIST_PROJECT_IDS=
AUTHORING_PROPOSAL_TTL_SECONDS=86400
AUTHORING_MODEL_CALL_BUDGET=9
AUTHORING_MAX_REVISIONS=2
AUTHORING_MAX_OUTPUT_TOKENS=65536
AUTHORING_MAX_OUTPUT_BYTES=4194304

# Storage authority is dormant until the separately controlled activation.
STORAGE_AUTHORITY_MODE=legacy
STORAGE_PROTECTED_ROOT=/var/db/textweaver/storage
STORAGE_QUARANTINE_ROOT=/var/db/textweaver/quarantine

# Broker runtime. Replace password placeholders locally; never commit secrets.
STORAGE_BROKER_DATABASE_HOST=127.0.0.1
STORAGE_BROKER_DATABASE_PORT=3306
STORAGE_BROKER_DATABASE_NAME=textweaver
STORAGE_BROKER_DATABASE_USER=wa_storage_broker
STORAGE_BROKER_DATABASE_PASSWORD=replace-with-storage-broker-database-password
STORAGE_BROKER_INSTANCE_ID=local-storage-broker-1
STORAGE_BROKER_CONTRACT=storage-broker.v1
STORAGE_BROKER_LEASE_SECONDS=30
STORAGE_BROKER_POLL_INTERVAL_MS=500

# Read-only preflight connection. Use an operator-owned credential at runtime.
STORAGE_PREFLIGHT_DATABASE_USER=replace-with-read-only-preflight-user
STORAGE_PREFLIGHT_DATABASE_PASSWORD=replace-with-read-only-preflight-password

# Kernel authority contract; scripts only inspect these identities and modes.
STORAGE_API_OS_USER=_twapi
STORAGE_WORKER_OS_USER=_twworker
STORAGE_BROKER_OS_USER=_twfs
STORAGE_PROTECTED_OWNER=_twfs
STORAGE_PROTECTED_GROUP=_twread
STORAGE_PROTECTED_ROOT_MODE=710
STORAGE_QUARANTINE_OWNER=_twapi
STORAGE_QUARANTINE_GROUP=_twingest
STORAGE_QUARANTINE_ROOT_MODE=2730
