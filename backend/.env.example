# ===== 本地服务（仅 NODE_ENV=development 可使用以下默认值） =====
NODE_ENV=development
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=textweaver
DATABASE_USER=textweaver
DATABASE_PASSWORD=textweaver_local

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_local

# ===== JWT =====
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ===== LLM =====
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 每百万 token 的美元价格；未配置的模型仍记录 usage，但 cost_usd 保持 NULL。
# 例：{"deepseek":{"deepseek-chat":{"input_per_million_usd":"<price>","output_per_million_usd":"<price>"}}}
MODEL_PRICING_JSON={}
# 可选的 claim-evidence 语义复核；仅处理确定性校验无法判定的声明。
GROUNDING_SEMANTIC_REVIEW_ENABLED=true
GROUNDING_SEMANTIC_REVIEW_MAX_TOKENS=1200
GROUNDING_SEMANTIC_REVIEW_MAX_COST_USD=0.01
# Atomic grounding runtime: off | shadow_no_persist. Default: off.
# 当前 shadow 实现会验证并流式输出候选，但不会持久化为正式内容。
ATOMIC_GROUNDING_MODE=off
ATOMIC_GROUNDING_METRICS_HOST=127.0.0.1
ATOMIC_GROUNDING_METRICS_PORT=9465
# Deterministic authoring rollout: off | shadow | enforce_allowlist.
# Enforce also requires broker storage readiness and an exact project UUID.
AUTHORING_COMMIT_MODE=off
AUTHORING_ALLOWLIST_PROJECT_IDS=
# 使用 Anthropic 时，将 LLM_PROVIDER 改为 anthropic 并设置以下变量：
# ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ===== Embedding =====
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
# 未配置时 dense indexing 会停用，shadow 模式仍可使用 legacy 检索结果。
OPENAI_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# 可选；用于记录线上 query embedding 成本。
# EMBEDDING_PRICE_PER_MILLION_USD=

# ===== Hybrid RAG / Qdrant =====
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=write_agent_chunks
QDRANT_TIMEOUT_MS=5000
# QDRANT_API_KEY=
RAG_INDEX_VERSION=rag-v1
# legacy: 仅旧 LIKE；shadow: 旧链路对外、Hybrid 仅评测；hybrid: 需评测报告通过
RETRIEVAL_MODE=shadow
RAG_MAX_LATENCY_P95_MS=500
RAG_EVALUATION_MIN_SAMPLES=20
RAG_EVALUATION_MIN_POSITIVE_JUDGMENTS=20
RAG_EVALUATION_MAX_AGE_HOURS=48
RAG_EVALUATION_MAX_TTL_HOURS=168
RAG_EVALUATION_FUTURE_SKEW_SECONDS=300
# hybrid 模式必须同时配置以下全部值。artifact 仅由 rag:evaluate:production 生成
# corpus ingestion + sparse + dense + fusion + context pipeline 后签名生成。
# RAG_EVALUATION_DIR=./evaluation/rag/artifacts
# RAG_EVALUATION_REPORT=./evaluation/rag/artifacts/chinese-textbook-v2.json
# RAG_EVALUATION_ARTIFACT_SHA256=
# RAG_EVALUATION_HMAC_SECRET=
# RAG_EVALUATION_DATASET_DIGEST=
# RAG_CODE_COMMIT=
# RAG_RETRIEVAL_CONFIG_HASH=

# ===== 文件存储 =====
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50mb
MAX_USER_STORAGE=500mb

# ===== Storage authority =====
# 当前默认部署仅支持 legacy；broker 激活流程尚未作为公开部署能力开放。
STORAGE_AUTHORITY_MODE=legacy

# ===== 应用 =====
PORT=3002
FRONTEND_URL=http://localhost:8002
